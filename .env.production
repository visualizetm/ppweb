# Build-mode flag. NOT a secret — it is a public feature flag, and it is the only
# VITE_-prefixed variable this project permits anywhere near auth.
#
# true  -> demo build: mocked data layer, seeded bookings, stubbed payments,
#          demo badge, noindex meta, admin login accepts any password.
# false -> production build: real /api endpoints, real MongoDB, real HMAC session
#          auth against ADMIN_PASSWORD (server-side only).
#
# Flipping this one line is the entire promotion path. See DEMO-TO-PRODUCTION.md.
VITE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Paps Productions — environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Set the server-side values in the
# Vercel dashboard for production.
#
# HARD RULE: never prefix a secret with VITE_. Vite inlines every VITE_ variable
# into the public client bundle, where anyone can read it with view-source.
# The only VITE_ variable in this project is the build-mode flag below, which is
# not a secret.
# ---------------------------------------------------------------------------

# --- Public build flag (safe to expose) ------------------------------------
VITE_DEMO_MODE=true


# ===========================================================================
# Everything below is server-side only and is UNUSED while VITE_DEMO_MODE=true.
# ===========================================================================

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. The database name is taken from the URI path.
MONGODB_URI=

# --- Admin auth -------------------------------------------------------------
# Random 32+ byte string used to HMAC-sign session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The admin dashboard password. Checked server-side only, never shipped to the
# browser, never prefixed with VITE_.
ADMIN_PASSWORD=

# --- Notifications ----------------------------------------------------------
# Web3Forms access key used to email Michael when a booking lands.
WEB3FORMS_NOTIFY_KEY=
# Where booking notifications are delivered.
NOTIFY_EMAIL=

# --- Stripe -----------------------------------------------------------------
# NOT USED IN THE DEMO. No Stripe SDK is loaded and no network call is made
# while VITE_DEMO_MODE=true. See DEMO-TO-PRODUCTION.md before setting these.
#
# The secret key is server-side only. It must never be given a VITE_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The publishable key IS safe client-side, but is only read once demo mode is off.
VITE_STRIPE_PUBLISHABLE_KEY=

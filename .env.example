# ---------------------------------------------------------------------------
# Paps Productions environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Set every value in the Vercel
# dashboard for production (Project -> Settings -> Environment Variables).
#
# HARD RULE: never prefix a secret with VITE_. Vite inlines every VITE_
# variable into the public client bundle, where anyone can read it with
# view-source. There are currently NO VITE_ variables in this project at all.
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# MongoDB Atlas connection string. The database name is taken from the URI
# path, so include it: mongodb+srv://user:pass@cluster/papsprod?retryWrites=true
MONGODB_URI=

# --- Admin auth (required) --------------------------------------------------
# Random 32+ byte string used to HMAC-sign session cookies. Changing it signs
# every existing admin session out immediately.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The admin dashboard password. Checked server-side only, never shipped to the
# browser, never prefixed with VITE_.
ADMIN_PASSWORD=

# --- Image uploads (required for the admin image manager) -------------------
# Vercel Blob read/write token. Create a Blob store in the Vercel dashboard
# (Storage -> Blob) and connect it to this project; Vercel injects this
# variable automatically. Without it the upload endpoint returns 503 and the
# rest of the dashboard keeps working.
BLOB_READ_WRITE_TOKEN=

# --- Notifications (optional) -----------------------------------------------
# Web3Forms access key used to email Michael when a booking lands. If either
# of these is missing, bookings are still saved; only the email is skipped.
WEB3FORMS_NOTIFY_KEY=
# Where booking notifications are delivered.
NOTIFY_EMAIL=

# --- Stripe -----------------------------------------------------------------
# NOT WIRED UP. api/invoices/pay.js is a deliberate 501 stub and no Stripe SDK
# is loaded anywhere. Leave these unset until the payment pass happens.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
